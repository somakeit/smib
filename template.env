# REQUIRED
## Slack Configuration
SMIB_SLACK_BOT_TOKEN=
SMIB_SLACK_APP_TOKEN=

# OPTIONAL - uncomment to change default values
## Slack Configuration
#SMIB_SLACK_SIGNING_SECRET=

## Environment Settings
#SMIB_ENVIRONMENT=production

## General Settings
# Standard timezone used when SMIB_TIMEZONE is unset
#TZ=Europe/London
# Explicit application timezone override
#SMIB_TIMEZONE=Europe/London

## Database Settings
#SMIB_DB_MONGO_DB_HOST=localhost
#SMIB_DB_MONGO_DB_PORT=27017
#SMIB_DB_MONGO_DB_NAME=smib

## Webserver Settings
#SMIB_WEBSERVER_HOST=0.0.0.0
#SMIB_WEBSERVER_PORT=80
#SMIB_WEBSERVER_PATH_PREFIX=/
#SMIB_WEBSERVER_FORWARDED_ALLOW_IPS=*
#SMIB_WEBSERVER_LOG_REQUEST_DETAILS=false

## Logging Settings
#SMIB_LOGGING_LOG_LEVEL=INFO

## Docker Compose Settings
#SMIB_COMPOSE_MONGO_DB_TAG=latest
#SMIB_COMPOSE_ME_MONGO_DB_URL=mongodb://smib-db:27017/

## Proxy Settings
#SMIB_PROXY_EXTERNAL_PORT=80
#SMIB_PROXY_TRUSTED_PROXIES=

## Plugin Settings
# Space State Plugin
#SMIB_PLUGIN_SPACE_STATE_SPACE_OPEN_ANNOUNCE_CHANNEL_ID=space-open-announce

# Static Files Plugin
#SMIB_PLUGIN_STATIC_FILES_STATIC_FILES_DIRECTORY=static

# How Fresh? Plugin
#SMIB_PLUGIN_SPACE_HOW_FRESH_STALE_AFTER=1:00:00
#SMIB_PLUGIN_SPACE_HOW_FRESH_EXCLUDE_AFTER=2 days, 0:00:00
# Per-device overrides, keyed on hostname (case insensitive, - and _ interchangeable,
# so SMIBHID-FAN is written SMIBHID_FAN). Only needed to give a device a friendly name
# or a different freshness threshold.
#SMIB_PLUGIN_SPACE_HOW_FRESH_DEVICE__SMIBHID_FAN__NAME=Clean Room
#SMIB_PLUGIN_SPACE_HOW_FRESH_DEVICE__SMIBHID_FAN__ORDER=1
#SMIB_PLUGIN_SPACE_HOW_FRESH_DEVICE__SMIBHID_WORKSHOP__NAME=Workshop
#SMIB_PLUGIN_SPACE_HOW_FRESH_DEVICE__SMIBHID_WORKSHOP__ORDER=2
# Only for a device on a slower reporting cadence than the rest:
#SMIB_PLUGIN_SPACE_HOW_FRESH_DEVICE__SMIBHID_SPARE__STALE_AFTER=PT3H
#SMIB_PLUGIN_SPACE_HOW_FRESH_DEVICE__SMIBHID_SPARE__EXCLUDE_AFTER=P7D

# S.M.I.B.H.I.D. Plugin
#SMIB_PLUGIN_SMIBHID_SENSOR_MONITOR_INTERVAL=0:01:00
#SMIB_PLUGIN_SMIBHID_SENSOR_MONITOR_ALERT_THRESHOLD=1:00:00
#SMIB_PLUGIN_SMIBHID_SENSOR_MONITOR_ALERT_RESEND_INTERVAL=None
#SMIB_PLUGIN_SMIBHID_SENSOR_MONITOR_ALERT_CHANNEL_ID=code
